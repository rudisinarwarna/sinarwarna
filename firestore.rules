rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Shared Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && isVerified() && request.auth.uid == userId;
    }

    function isParentConversationOwner(conversationId) {
      return exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
        get(/databases/$(database)/documents/conversations/$(conversationId)).data.userId == request.auth.uid;
    }

    // Validation Blueprints
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'photoUrl', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.uid == userId &&
        data.uid == request.auth.uid &&
        data.displayName is string &&
        data.displayName.size() >= 1 &&
        data.displayName.size() <= 100 &&
        (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidConversation(data, conversationId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'mode', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'title', 'mode', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.id == conversationId &&
        isValidId(data.userId) &&
        data.userId == request.auth.uid &&
        data.title is string &&
        data.title.size() >= 1 &&
        data.title.size() <= 120 &&
        data.mode is string &&
        data.mode.size() <= 32 &&
        data.mode in ['general', 'copywriting', 'design', 'campaign'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMessage(data, conversationId, messageId) {
      return data.keys().hasAll(['id', 'conversationId', 'userId', 'role', 'text', 'createdAt']) &&
        data.keys().hasOnly(['id', 'conversationId', 'userId', 'role', 'text', 'attachmentNames', 'error', 'createdAt']) &&
        isValidId(data.id) &&
        data.id == messageId &&
        isValidId(data.conversationId) &&
        data.conversationId == conversationId &&
        isValidId(data.userId) &&
        data.userId == request.auth.uid &&
        data.role is string &&
        data.role.size() <= 16 &&
        data.role in ['user', 'model'] &&
        data.text is string &&
        data.text.size() <= 32000 &&
        (!('attachmentNames' in data) || (
          data.attachmentNames is list &&
          data.attachmentNames.size() <= 3 &&
          (data.attachmentNames.size() == 0 || (data.attachmentNames[0] is string && data.attachmentNames[0].size() <= 120))
        )) &&
        (!('error' in data) || (data.error is string && data.error.size() <= 500)) &&
        data.createdAt is timestamp;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['photoUrl', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl', 'updatedAt'])
        );
      allow delete: if false;
    }

    // Conversations Collection
    match /conversations/{conversationId} {
      allow get: if isSignedIn() &&
        isVerified() &&
        isValidId(conversationId) &&
        existing().userId == request.auth.uid;
      allow list: if isSignedIn() &&
        isVerified() &&
        resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
        isVerified() &&
        isValidId(conversationId) &&
        isValidConversation(incoming(), conversationId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isSignedIn() &&
        isVerified() &&
        isValidId(conversationId) &&
        existing().userId == request.auth.uid &&
        isValidConversation(incoming(), conversationId) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['mode', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'mode', 'updatedAt'])
        );
      allow delete: if isSignedIn() &&
        isVerified() &&
        isValidId(conversationId) &&
        existing().userId == request.auth.uid;

      // Messages Subcollection
      match /messages/{messageId} {
        allow get: if isSignedIn() &&
          isVerified() &&
          isValidId(conversationId) &&
          isValidId(messageId) &&
          existing().userId == request.auth.uid &&
          isParentConversationOwner(conversationId);
        allow list: if isSignedIn() &&
          isVerified() &&
          resource.data.userId == request.auth.uid;
        allow create: if isSignedIn() &&
          isVerified() &&
          isValidId(conversationId) &&
          isValidId(messageId) &&
          isValidMessage(incoming(), conversationId, messageId) &&
          incoming().createdAt == request.time &&
          isParentConversationOwner(conversationId);
        allow update: if isSignedIn() &&
          isVerified() &&
          isValidId(conversationId) &&
          isValidId(messageId) &&
          existing().userId == request.auth.uid &&
          isValidMessage(incoming(), conversationId, messageId) &&
          incoming().id == existing().id &&
          incoming().conversationId == existing().conversationId &&
          incoming().userId == existing().userId &&
          incoming().role == existing().role &&
          incoming().createdAt == existing().createdAt &&
          isParentConversationOwner(conversationId) &&
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['text']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['error']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['text', 'error'])
          );
        allow delete: if isSignedIn() &&
          isVerified() &&
          isValidId(conversationId) &&
          isValidId(messageId) &&
          existing().userId == request.auth.uid &&
          isParentConversationOwner(conversationId);
      }
    }
  }
}
