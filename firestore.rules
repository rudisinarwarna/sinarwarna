rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Shared Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return request.auth.token.email_verified == true;
    }

    function isPrimaryAdmin() {
      return isSignedIn() &&
        isVerified() &&
        request.auth.token.email == 'rudi.sinarwarna@gmail.com';
    }

    function isNotBlocked() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid)) || (
        (
          !('blocked' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.blocked != true
        ) &&
        (
          !('deleted' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.deleted != true
        )
      );
    }

    function isFreewillActive() {
      return exists(/databases/$(database)/documents/appConfig/freewill) &&
        get(/databases/$(database)/documents/appConfig/freewill).data.enabled == true;
    }

    function isAnyAdmin() {
      return isPrimaryAdmin() || (
        isSignedIn() &&
        isVerified() &&
        isNotBlocked() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isAdminOrFreewill() {
      return isAnyAdmin() || (
        isSignedIn() &&
        isVerified() &&
        isNotBlocked() &&
        isFreewillActive()
      );
    }

    function isAdminPlus() {
      return isPrimaryAdmin() || (
        isSignedIn() &&
        isVerified() &&
        isNotBlocked() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        'level' in get(/databases/$(database)/documents/admins/$(request.auth.uid)).data &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.level == 'admin_plus'
      );
    }

    function targetIsPrimaryAdmin(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
        'email' in get(/databases/$(database)/documents/users/$(userId)).data &&
        get(/databases/$(database)/documents/users/$(userId)).data.email == 'rudi.sinarwarna@gmail.com';
    }

    function targetAdminLevel(userId) {
      return targetIsPrimaryAdmin(userId)
        ? 'primary'
        : (
          exists(/databases/$(database)/documents/admins/$(userId))
            ? (
              ('level' in get(/databases/$(database)/documents/admins/$(userId)).data &&
               get(/databases/$(database)/documents/admins/$(userId)).data.level == 'admin_plus')
                ? 'admin_plus'
                : 'admin'
            )
            : (
              exists(/databases/$(database)/documents/users/$(userId))
                ? get(/databases/$(database)/documents/users/$(userId)).data.role
                : 'user'
            )
        );
    }

    function canManageTargetUpdate(userId, nextRole) {
      return !targetIsPrimaryAdmin(userId) && (
        (isPrimaryAdmin() && nextRole in ['user', 'admin', 'admin_plus']) ||
        (isAdminPlus() && !isPrimaryAdmin() && targetAdminLevel(userId) in ['user', 'admin'] && nextRole in ['user', 'admin']) ||
        (isAdminOrFreewill() && !isAdminPlus() && targetAdminLevel(userId) == 'user' && nextRole in ['user', 'admin'])
      );
    }

    function canManageTargetDelete(userId) {
      return !targetIsPrimaryAdmin(userId) && (
        isPrimaryAdmin() ||
        (isAdminPlus() && !isPrimaryAdmin() && targetAdminLevel(userId) in ['user', 'admin']) ||
        (isAdminOrFreewill() && !isAdminPlus() && targetAdminLevel(userId) == 'user')
      );
    }

    function isOwner(userId) {
      return isSignedIn() && isVerified() && request.auth.uid == userId;
    }

    function isParentConversationOwner(conversationId) {
      return exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
        get(/databases/$(database)/documents/conversations/$(conversationId)).data.userId == request.auth.uid;
    }

    // Validation Blueprints
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'blocked', 'deleted', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'email', 'photoUrl', 'role', 'verifiedBadge', 'blocked', 'deleted', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.uid == userId &&
        data.displayName is string &&
        data.displayName.size() >= 1 &&
        data.displayName.size() <= 100 &&
        (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
        (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
        data.role is string &&
        data.role.size() <= 16 &&
        data.role in ['user', 'admin', 'admin_plus'] &&
        (!('verifiedBadge' in data) || data.verifiedBadge is bool) &&
        data.blocked is bool &&
        data.deleted is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdminGrant(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'grantedBy', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'level', 'grantedBy', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.uid == userId &&
        data.email is string &&
        data.email.size() <= 200 &&
        (!('level' in data) || (data.level is string && data.level.size() <= 16 && data.level in ['admin', 'admin_plus'])) &&
        data.grantedBy is string &&
        data.grantedBy.size() >= 1 &&
        data.grantedBy.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdminMemory(data, memoryId) {
      return data.keys().hasAll(['id', 'title', 'content', 'createdBy', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'title', 'content', 'createdBy', 'createdByEmail', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.id == memoryId &&
        data.title is string &&
        data.title.size() >= 1 &&
        data.title.size() <= 120 &&
        data.content is string &&
        data.content.size() >= 1 &&
        data.content.size() <= 2000 &&
        data.createdBy is string &&
        data.createdBy.size() >= 1 &&
        data.createdBy.size() <= 128 &&
        (!('createdByEmail' in data) || (data.createdByEmail is string && data.createdByEmail.size() <= 200)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdminSeedMeta(data) {
      return data.keys().hasAll(['seededDefaultMemories', 'updatedBy', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['seededDefaultMemories', 'updatedBy', 'createdAt', 'updatedAt']) &&
        data.seededDefaultMemories is bool &&
        data.updatedBy is string &&
        data.updatedBy.size() >= 1 &&
        data.updatedBy.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidLiveSettings(data) {
      return data.keys().hasAll(['greetingText', 'updatedBy', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['greetingText', 'updatedBy', 'createdAt', 'updatedAt']) &&
        data.greetingText is string &&
        data.greetingText.size() <= 500 &&
        data.updatedBy is string &&
        data.updatedBy.size() >= 1 &&
        data.updatedBy.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidFreewillSettings(data) {
      return data.keys().hasAll(['enabled', 'memoriesSummary', 'updatedBy', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['enabled', 'memoriesSummary', 'updatedBy', 'createdAt', 'updatedAt']) &&
        data.enabled is bool &&
        data.memoriesSummary is string &&
        data.memoriesSummary.size() <= 10000 &&
        data.updatedBy is string &&
        data.updatedBy.size() >= 1 &&
        data.updatedBy.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPublicMemory(data, memoryId) {
      return data.keys().hasAll(['id', 'title', 'content', 'isPublic', 'createdBy', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'title', 'content', 'isPublic', 'createdBy', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.id == memoryId &&
        data.title is string &&
        data.title.size() >= 1 &&
        data.title.size() <= 120 &&
        data.content is string &&
        data.content.size() >= 1 &&
        data.content.size() <= 2000 &&
        data.isPublic is bool &&
        data.isPublic == true &&
        data.createdBy is string &&
        data.createdBy.size() >= 1 &&
        data.createdBy.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidConversation(data, conversationId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'mode', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'title', 'mode', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.id == conversationId &&
        isValidId(data.userId) &&
        data.userId == request.auth.uid &&
        data.title is string &&
        data.title.size() >= 1 &&
        data.title.size() <= 120 &&
        data.mode is string &&
        data.mode.size() <= 32 &&
        data.mode in ['general', 'copywriting', 'design', 'campaign'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMessage(data, conversationId, messageId) {
      return data.keys().hasAll(['id', 'conversationId', 'userId', 'role', 'text', 'createdAt']) &&
        data.keys().hasOnly(['id', 'conversationId', 'userId', 'role', 'text', 'attachmentNames', 'error', 'createdAt']) &&
        isValidId(data.id) &&
        data.id == messageId &&
        isValidId(data.conversationId) &&
        data.conversationId == conversationId &&
        isValidId(data.userId) &&
        data.userId == request.auth.uid &&
        data.role is string &&
        data.role.size() <= 16 &&
        data.role in ['user', 'model'] &&
        data.text is string &&
        data.text.size() <= 32000 &&
        (!('attachmentNames' in data) || (
          data.attachmentNames is list &&
          data.attachmentNames.size() <= 3 &&
          (data.attachmentNames.size() == 0 || (data.attachmentNames[0] is string && data.attachmentNames[0].size() <= 120))
        )) &&
        (!('error' in data) || (data.error is string && data.error.size() <= 500)) &&
        data.createdAt is timestamp;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdminOrFreewill());
      allow list: if isAdminOrFreewill();
      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        incoming().uid == request.auth.uid &&
        isValidUserProfile(incoming(), userId) &&
        (incoming().role == 'user' || (isPrimaryAdmin() && incoming().role in ['admin', 'admin_plus'])) &&
        (!('verifiedBadge' in incoming()) || incoming().verifiedBadge == false || (isPrimaryAdmin() && incoming().verifiedBadge == true)) &&
        incoming().blocked == false &&
        incoming().deleted == false &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            isOwner(userId) &&
            isNotBlocked() &&
            (!('blocked' in existing()) ? incoming().blocked == false : incoming().blocked == existing().blocked) &&
            (!('deleted' in existing()) ? incoming().deleted == false : incoming().deleted == existing().deleted) &&
            (!('role' in existing())
              ? (incoming().role == 'user' || (isPrimaryAdmin() && incoming().role in ['admin', 'admin_plus']))
              : (incoming().role == existing().role || (isPrimaryAdmin() && incoming().role in ['admin', 'admin_plus']))) &&
            (!('verifiedBadge' in existing())
              ? (!('verifiedBadge' in incoming()) || incoming().verifiedBadge == false || (isPrimaryAdmin() && incoming().verifiedBadge == true) || incoming().role in ['admin', 'admin_plus'])
              : (!('verifiedBadge' in incoming()) || incoming().verifiedBadge == existing().verifiedBadge || (isPrimaryAdmin() && incoming().verifiedBadge == true))) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoUrl', 'role', 'verifiedBadge', 'blocked', 'deleted', 'updatedAt'])
          ) ||
          (
            request.auth.uid != userId &&
            canManageTargetUpdate(userId, incoming().role) &&
            (incoming().role == 'user' || incoming().verifiedBadge == true) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['role', 'verifiedBadge', 'blocked', 'deleted', 'updatedAt'])
          )
        );
      allow delete: if isValidId(userId) &&
        request.auth.uid != userId &&
        canManageTargetDelete(userId);
    }

    // Admin Grants Collection
    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdminOrFreewill());
      allow list: if isAdminOrFreewill();
      allow create: if isValidId(userId) &&
        isValidAdminGrant(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          (isPrimaryAdmin() && request.auth.uid == userId && (!('level' in incoming()) || incoming().level == 'admin_plus')) ||
          (isPrimaryAdmin() && !targetIsPrimaryAdmin(userId)) ||
          (isAdminPlus() && !isPrimaryAdmin() && request.auth.uid != userId && targetAdminLevel(userId) in ['user', 'admin'] && (!('level' in incoming()) || incoming().level == 'admin')) ||
          (isAdminOrFreewill() && !isAdminPlus() && request.auth.uid != userId && targetAdminLevel(userId) == 'user' && (!('level' in incoming()) || incoming().level == 'admin'))
        );
      allow update: if isValidId(userId) &&
        isValidAdminGrant(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['level', 'grantedBy', 'updatedAt']) &&
        (
          (isPrimaryAdmin() && request.auth.uid == userId && (!('level' in incoming()) || incoming().level == 'admin_plus')) ||
          (isPrimaryAdmin() && !targetIsPrimaryAdmin(userId))
        );
      allow delete: if isValidId(userId) &&
        request.auth.uid != userId &&
        (!('email' in existing()) || existing().email != 'rudi.sinarwarna@gmail.com') &&
        (
          isPrimaryAdmin() ||
          (isAdminPlus() && !isPrimaryAdmin() && targetAdminLevel(userId) in ['user', 'admin'])
        );
    }

    // Admin+ & Primary Admin Private AI Memories Collection (never accessible to plain Admin or regular users)
    match /adminMemories/{memoryId} {
      allow get, list: if isAdminPlus();
      allow create: if isAdminPlus() &&
        isValidId(memoryId) &&
        isValidAdminMemory(incoming(), memoryId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAdminPlus() &&
        isValidId(memoryId) &&
        isValidAdminMemory(incoming(), memoryId) &&
        incoming().id == existing().id &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'updatedAt']);
      allow delete: if isAdminPlus() && isValidId(memoryId);
    }

    // Admin+ Metadata (one-time default memory seed flag)
    match /adminMeta/{docId} {
      allow get: if isAdminPlus() && docId == 'seed';
      allow list: if false;
      allow create: if isAdminPlus() &&
        docId == 'seed' &&
        isValidAdminSeedMeta(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAdminPlus() &&
        docId == 'seed' &&
        isValidAdminSeedMeta(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['seededDefaultMemories', 'updatedBy', 'updatedAt']);
      allow delete: if false;
    }

    // Public AI Memories (non-PII, read by all for AI context; managed by Admin tier & above)
    match /publicMemories/{memoryId} {
      allow get: if isValidId(memoryId) && existing().isPublic == true;
      allow list: if resource.data.isPublic == true;
      allow create: if isAdminOrFreewill() &&
        isValidId(memoryId) &&
        isValidPublicMemory(incoming(), memoryId) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAdminOrFreewill() &&
        isValidId(memoryId) &&
        isValidPublicMemory(incoming(), memoryId) &&
        incoming().id == existing().id &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'updatedAt']);
      allow delete: if isAdminOrFreewill() && isValidId(memoryId);
    }

    // App Config ('live' writable by Admin+ & Primary Admin; 'freewill' writable exclusively by Primary Admin)
    match /appConfig/{docId} {
      allow get: if isValidId(docId) && docId in ['live', 'freewill'];
      allow list: if false;
      allow create: if isValidId(docId) && (
        (
          docId == 'live' &&
          isAdminPlus() &&
          isValidLiveSettings(incoming()) &&
          incoming().updatedBy == request.auth.uid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time
        ) ||
        (
          docId == 'freewill' &&
          isPrimaryAdmin() &&
          isValidFreewillSettings(incoming()) &&
          incoming().updatedBy == request.auth.uid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time
        )
      );
      allow update: if isValidId(docId) && (
        (
          docId == 'live' &&
          isAdminPlus() &&
          isValidLiveSettings(incoming()) &&
          incoming().updatedBy == request.auth.uid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['greetingText', 'updatedBy', 'updatedAt'])
        ) ||
        (
          docId == 'freewill' &&
          isPrimaryAdmin() &&
          isValidFreewillSettings(incoming()) &&
          incoming().updatedBy == request.auth.uid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['enabled', 'memoriesSummary', 'updatedBy', 'updatedAt'])
        )
      );
      allow delete: if false;
    }

    // Conversations Collection
    match /conversations/{conversationId} {
      allow get: if isSignedIn() &&
        isVerified() &&
        isValidId(conversationId) &&
        (existing().userId == request.auth.uid || isAdminOrFreewill());
      allow list: if isSignedIn() &&
        isVerified() &&
        (resource.data.userId == request.auth.uid || isAdminOrFreewill());
      allow create: if isSignedIn() &&
        isVerified() &&
        isNotBlocked() &&
        isValidId(conversationId) &&
        isValidConversation(incoming(), conversationId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isSignedIn() &&
        isVerified() &&
        isNotBlocked() &&
        isValidId(conversationId) &&
        existing().userId == request.auth.uid &&
        isValidConversation(incoming(), conversationId) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['mode', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'mode', 'updatedAt'])
        );
      allow delete: if isSignedIn() &&
        isVerified() &&
        isValidId(conversationId) &&
        (existing().userId == request.auth.uid || isAdminOrFreewill());

      // Messages Subcollection
      match /messages/{messageId} {
        allow get: if isSignedIn() &&
          isVerified() &&
          isValidId(conversationId) &&
          isValidId(messageId) &&
          ((existing().userId == request.auth.uid && isParentConversationOwner(conversationId)) || isAdminOrFreewill());
        allow list: if isSignedIn() &&
          isVerified() &&
          (resource.data.userId == request.auth.uid || isAdminOrFreewill());
        allow create: if isSignedIn() &&
          isVerified() &&
          isNotBlocked() &&
          isValidId(conversationId) &&
          isValidId(messageId) &&
          isValidMessage(incoming(), conversationId, messageId) &&
          incoming().createdAt == request.time &&
          isParentConversationOwner(conversationId);
        allow update: if isSignedIn() &&
          isVerified() &&
          isNotBlocked() &&
          isValidId(conversationId) &&
          isValidId(messageId) &&
          existing().userId == request.auth.uid &&
          isValidMessage(incoming(), conversationId, messageId) &&
          incoming().id == existing().id &&
          incoming().conversationId == existing().conversationId &&
          incoming().userId == existing().userId &&
          incoming().role == existing().role &&
          incoming().createdAt == existing().createdAt &&
          isParentConversationOwner(conversationId) &&
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['text']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['error']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['text', 'error'])
          );
        allow delete: if isSignedIn() &&
          isVerified() &&
          isValidId(conversationId) &&
          isValidId(messageId) &&
          ((existing().userId == request.auth.uid && isParentConversationOwner(conversationId)) || isAdminOrFreewill());
      }
    }
  }
}
