{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile and access control status.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the user."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "User display name."
        },
        "email": {
          "type": "string",
          "maxLength": 200,
          "description": "User email address (restricted to owner and admins)."
        },
        "photoUrl": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional profile avatar URL."
        },
        "role": {
          "type": "string",
          "enum": ["user", "admin", "admin_plus"],
          "maxLength": 16,
          "description": "Authorization role across user, plain admin, and admin plus tiers."
        },
        "verifiedBadge": {
          "type": "boolean",
          "description": "Blue verified checkmark granted only to admins or by admins."
        },
        "blocked": {
          "type": "boolean",
          "description": "Whether account access is blocked by an admin."
        },
        "deleted": {
          "type": "boolean",
          "description": "Whether account was deleted by an admin."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when profile was last updated."
        }
      },
      "required": ["uid", "displayName", "role", "blocked", "deleted", "createdAt", "updatedAt"]
    },
    "AdminGrant": {
      "title": "AdminGrant",
      "description": "Verified administrator role assignment record.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the admin."
        },
        "email": {
          "type": "string",
          "maxLength": 200,
          "description": "Email address of the admin."
        },
        "level": {
          "type": "string",
          "enum": ["admin", "admin_plus"],
          "maxLength": 16,
          "description": "Administrator privilege tier."
        },
        "grantedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "UID of the admin who granted the role."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "grantedBy", "createdAt", "updatedAt"]
    },
    "AdminMemory": {
      "title": "AdminMemory",
      "description": "Shared private AI memory visible exclusively to Admin+ and Primary Admin.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique memory identifier."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Short topic label for the private memory."
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "Private memory fact known across Admin+ and Primary Admin."
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "UID of the admin who recorded this memory."
        },
        "createdByEmail": {
          "type": "string",
          "maxLength": 200,
          "description": "Optional email of the admin who added this memory."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "title", "content", "createdBy", "createdAt", "updatedAt"]
    },
    "AdminSeedMeta": {
      "title": "AdminSeedMeta",
      "description": "Tracks one-time initialization of default private memories.",
      "type": "object",
      "properties": {
        "seededDefaultMemories": {
          "type": "boolean"
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["seededDefaultMemories", "updatedBy", "createdAt", "updatedAt"]
    },
    "AppLiveSettings": {
      "title": "AppLiveSettings",
      "description": "Configuration for AI Live opening words controlled exclusively by Admin+ and Primary Admin.",
      "type": "object",
      "properties": {
        "greetingText": {
          "type": "string",
          "maxLength": 500,
          "description": "Custom opening words spoken by AI Live when started; empty string falls back to default."
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "UID of the Admin+ or Primary Admin who updated the Live greeting."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["greetingText", "updatedBy", "createdAt", "updatedAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "A creative chat session owned by a specific authenticated user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique conversation identifier."
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Short creative session title."
        },
        "mode": {
          "type": "string",
          "enum": ["general", "copywriting", "design", "campaign"],
          "maxLength": 32,
          "description": "Active creative focus mode."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest activity."
        }
      },
      "required": ["id", "userId", "title", "mode", "createdAt", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "An individual user or model message within a conversation.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique message identifier."
        },
        "conversationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Parent conversation identifier."
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID matching the parent conversation."
        },
        "role": {
          "type": "string",
          "enum": ["user", "model"],
          "maxLength": 16,
          "description": "Message author role."
        },
        "text": {
          "type": "string",
          "maxLength": 32000,
          "description": "Markdown or plain text message body."
        },
        "attachmentNames": {
          "type": "array",
          "description": "Optional bounded list of attached reference image filenames (max 3)."
        },
        "error": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional error notice if generation failed."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when message was recorded."
        }
      },
      "required": ["id", "conversationId", "userId", "role", "text", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Per-user profile, readable/writable by owner (limited fields) and managed across tiered admins."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminGrant" },
      "description": "Verified administrator registry with admin and admin_plus tiers."
    },
    "/adminMemories/{memoryId}": {
      "schema": { "$ref": "#/entities/AdminMemory" },
      "description": "Shared private AI memories visible and writable exclusively by Admin+ and Primary Admin."
    },
    "/adminMeta/{docId}": {
      "schema": { "$ref": "#/entities/AdminSeedMeta" },
      "description": "Admin+ seed status document."
    },
    "/appConfig/{docId}": {
      "schema": { "$ref": "#/entities/AppLiveSettings" },
      "description": "Publicly readable AI Live opening greeting config writable exclusively by Admin+ and Primary Admin."
    },
    "/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "User-owned creative AI conversations."
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Ordered creative messages belonging to a parent conversation."
    }
  }
}
